generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  enxovais     Enxoval[]
}

model Enxoval {
  id        String      @id @default(cuid())
  nome      String
  tipo      String // casamento | bebe
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  guestKey  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  categorias Categoria[]
  shares    ShareLink[]
}

model Categoria {
  id        String   @id @default(cuid())
  enxovalId String
  enxoval   Enxoval  @relation(fields: [enxovalId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  ordem     Int      @default(0)
  templateId String?
  itens     Item[]
}

model Item {
  id          String    @id @default(cuid())
  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nome        String
  quantidade  Int       @default(1)
  prioridade  String    @default("desejavel") // essencial | desejavel | opcional
  status      String    @default("pendente") // pendente | comprado | ganho | adiado
  notas       String?
  isCustom    Boolean   @default(false)
  templateId  String?
  ordem       Int       @default(0)
}

model ShareLink {
  id        String   @id @default(cuid())
  enxovalId String
  enxoval   Enxoval  @relation(fields: [enxovalId], references: [id], onDelete: Cascade)
  token     String   @unique
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())
}
